# Server runtime configuration. Copy to .env for local development.

NODE_ENV=development
PORT=4000

# SQLite database file path (created automatically). Defaults to server/data/app.db.
# DB_PATH=./data/app.db

# Secret used to sign/derive session material. MUST be set to a long random
# value in production — never commit a real value.
SESSION_SECRET=dev-only-insecure-secret-change-me
SESSION_TTL_SECONDS=28800

# Frontend origin allowed to call this API with credentials.
CORS_ORIGIN=http://localhost:5173

# Optional: seed script overrides for the initial super admin account.
# SEED_ADMIN_EMAIL=admin@nepalctf.org
# SEED_ADMIN_PASSWORD=ChangeMe123!

# Base URL of the CTFd instance this backend mirrors approved teams into.
# VITE_CTFD_BASE_URL=https://ctf.example.org
