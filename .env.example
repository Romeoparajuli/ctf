# Base URL of the CTFd instance this UI talks to (no trailing slash).
# Only used when VITE_USE_MOCK_API=false.
VITE_CTFD_BASE_URL=https://ctf.example.org

# When true (default), the app runs entirely against the in-memory mock
# adapter in src/services/api/mockApi.ts — no real CTFd instance required.
# Set to false once a live CTFd instance is available.
VITE_USE_MOCK_API=true

# Optional: name shown in headers/success screens.
VITE_EVENT_NAME=Nepal CTF
